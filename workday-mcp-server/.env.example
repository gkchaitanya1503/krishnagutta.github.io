# Workday REST API Configuration
# Replace these values with your Workday tenant details

# Your Workday REST API base URL
# Format: https://<hostname>/ccx/api/v1/<tenant>
WORKDAY_BASE_URL=https://wd5-impl-services1.workday.com/ccx/api/v1/your_tenant

# Workday OAuth 2.0 Token Endpoint
# Format: https://<hostname>/ccx/oauth2/<tenant>/token
WORKDAY_TOKEN_URL=https://wd5-impl-services1.workday.com/ccx/oauth2/your_tenant/token

# OAuth 2.0 Client Credentials (register an API Client in Workday)
WORKDAY_CLIENT_ID=your_client_id
WORKDAY_CLIENT_SECRET=your_client_secret

# Workday Refresh Token (obtained via authorization code flow)
# If provided, refresh token grant is used instead of client_credentials
WORKDAY_REFRESH_TOKEN=

# Optional: RAAS (Report as a Service) base URL
# Format: https://<hostname>/ccx/service/customreport2/<tenant>
WORKDAY_RAAS_URL=https://wd5-impl-services1.workday.com/ccx/service/customreport2/your_tenant
