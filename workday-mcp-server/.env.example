# ─────────────────────────────────────────────────────────────────────────────
# Workday MCP Server — Environment Configuration
# Copy this file to .env and fill in values from your Workday tenant
# Run inside a GitHub Codespace for automatic HTTPS callback URL
# ─────────────────────────────────────────────────────────────────────────────

# Callback URL — auto-detected from Codespace env vars when running in Codespace.
# Codespace URL format: https://{CODESPACE_NAME}-3000.{GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN}/callback
# Leave blank to let the server auto-detect from $CODESPACE_NAME.
REDIRECT_URI=

# ── Workday Tenant ───────────────────────────────────────────────────────────
# Your Workday tenant ID (e.g. "acme_corp1", "mycompany_impl")
WORKDAY_TENANT_ID=your_tenant_id

# Workday base hostname (no trailing slash)
#   Implementation: https://wd5-impl-services1.workday.com
#   Production:     https://wd2-services1.workday.com
WORKDAY_BASE_URL=https://wd5-impl-services1.workday.com

# Token exchange endpoint — typically derived but verify against your tenant
WORKDAY_TOKEN_URL=https://wd5-impl-services1.workday.com/ccx/oauth2/your_tenant_id/token

# ⚠️  IMPORTANT: The authorize endpoint hostname is OFTEN DIFFERENT from
# the API/token hostname. Check your Workday API client settings page — it
# shows the exact Authorization Endpoint URL. Paste it here verbatim.
WORKDAY_AUTH_URL=https://wd5-impl.workday.com/your_tenant_id/authorize

# ── OAuth 2.0 PKCE Client ────────────────────────────────────────────────────
# Register an API Client in Workday with:
#   - Grant Type: Authorization Code Grant
#   - PKCE: Enabled (Required)
#   - Access Token Type: Bearer
#   - Redirect URI: your Codespace callback URL (see above)
# Client ID is NOT secret in a PKCE flow — safe to commit.
WORKDAY_CLIENT_ID=your_client_id_here

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000
ADMIN_KEY=change-this-to-a-secret

# ── Optional: Pre-seeded Access Token ────────────────────────────────────────
# If you already have a valid Bearer token, paste it here to skip the
# browser-based OAuth flow. Tokens expire after ~60 minutes.
WORKDAY_ACCESS_TOKEN=
