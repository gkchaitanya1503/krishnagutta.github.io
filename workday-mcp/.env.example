# ──────────────────────────────────────────────────────────────
# Workday MCP Server — Environment Configuration
# Copy this file to .env and fill in your Workday tenant details
# ──────────────────────────────────────────────────────────────

# ── Workday Tenant ────────────────────────────────────────────
# Your Workday tenant ID (e.g. "acme_corp1", "mycompany_impl")
WORKDAY_TENANT_ID=your_tenant_id

# Workday base hostname (no trailing slash)
# Examples:
#   Implementation: https://wd5-impl-services1.workday.com
#   Production:     https://wd2-services1.workday.com
WORKDAY_BASE_URL=https://wd5-impl-services1.workday.com

# ── OAuth 2.0 Client (PKCE) ──────────────────────────────────
# Register an API Client in Workday with:
#   - Grant Type: Authorization Code
#   - PKCE: Enabled (Required)
#   - Token Type: Bearer
#   - Redirect URI: https://<YOUR-CODESPACE>-4000.<DOMAIN>/callback
WORKDAY_CLIENT_ID=your_client_id

# ── Derived URLs (auto-constructed from above if not set) ─────
# Override only if your Workday instance uses non-standard paths
# WORKDAY_TOKEN_URL=https://wd5-impl-services1.workday.com/ccx/oauth2/your_tenant_id/token
# WORKDAY_AUTH_URL=https://wd5-impl-services1.workday.com/authorize

# ── Redirect URI ──────────────────────────────────────────────
# Auto-detected in GitHub Codespaces. Override for custom deployments.
# WORKDAY_REDIRECT_URI=https://your-server.example.com/callback

# ── Server ────────────────────────────────────────────────────
PORT=4000
ADMIN_KEY=change-this-to-a-secret

# ── Optional: Pre-seeded Access Token ─────────────────────────
# If you already have a valid Bearer token, paste it here to skip
# the browser-based OAuth flow. Tokens expire after ~60 minutes.
# WORKDAY_ACCESS_TOKEN=
