{
  "name": "workday-mcp-server",
  "version": "1.0.0",
  "description": "Generic Workday MCP Server with OAuth 2.0 PKCE authentication for Claude Desktop",
  "main": "server.mjs",
  "type": "module",
  "scripts": {
    "start": "pm2 start ecosystem.config.cjs && pm2 save",
    "stop": "pm2 stop workday-mcp",
    "restart": "pm2 startOrRestart ecosystem.config.cjs && pm2 save",
    "reload": "git pull && npm install --silent && pm2 startOrRestart ecosystem.config.cjs && pm2 save",
    "logs": "pm2 logs workday-mcp --lines 50",
    "status": "pm2 status",
    "dev": "node server.mjs",
    "mcp": "node mcp-server.mjs",
    "demo-warmup": "node scripts/demo-warmup.mjs"
  },
  "keywords": [
    "mcp",
    "workday",
    "oauth",
    "pkce",
    "hcm",
    "claude-desktop",
    "model-context-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.2",
    "axios": "^1.6.0",
    "dotenv": "^16.0.0",
    "express": "^4.22.1",
    "open": "^8.4.2",
    "zod": "^3.22.0"
  }
}
